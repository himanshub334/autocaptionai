# ─── AutoCaption AI – Environment Configuration ─────────────────────────────
# Copy this file to .env and customize before running docker-compose up

# ── Database ──────────────────────────────────────────────────────────────
DB_PASSWORD=change_this_secure_password

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_this_redis_password

# ── MinIO (S3-compatible storage) ────────────────────────────────────────
MINIO_ACCESS_KEY=autocaption
MINIO_SECRET_KEY=change_this_minio_secret_min_8_chars
MINIO_BUCKET=autocaption-videos

# ── JWT Secrets (use long random strings in production) ────────────────
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string

# ── AI Service ────────────────────────────────────────────────────────────
# Whisper model: tiny, base, small, medium, large-v2, large-v3
# Larger = more accurate but slower and needs more RAM
WHISPER_MODEL=base

# Device: cpu or cuda (requires NVIDIA GPU + nvidia-docker)
DEVICE=cpu

# Compute type: int8 (CPU-friendly), float16 (GPU), float32
COMPUTE_TYPE=int8

# Optional: HuggingFace token for Pyannote diarization models
# Get one free at https://huggingface.co/settings/tokens
# Required to use speaker diarization feature
HF_TOKEN=

# ── App Settings ──────────────────────────────────────────────────────────
MAX_FILE_SIZE=500
FRONTEND_URL=http://localhost
VITE_API_URL=http://localhost
